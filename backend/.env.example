# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://mada_user:mada_password@localhost:5432/mada_marketplace

# --- Serveur ---
PORT=4000
NODE_ENV=development

# --- Authentification ---
JWT_SECRET=change-moi-avec-une-chaine-aleatoire-longue
JWT_EXPIRES_IN=7d

# --- Setup à distance (pour déployer/initialiser sans terminal, ex: depuis un téléphone) ---
# Choisis une valeur secrète et longue. Retire ou change cette valeur une fois
# la base initialisée pour ne pas laisser la route /api/setup/migrate exposée.
SETUP_TOKEN=change-moi-avec-un-secret-long

# --- Numéros de réception mobile money de la plateforme ---
# Numéros RÉELS appartenant à l'administration de Baobab Market, affichés
# aux clients/fournisseurs pour savoir où transférer l'argent (commandes
# ET dépôts de portefeuille). Tant qu'un numéro n'est pas renseigné ici,
# le site affiche "à configurer" au lieu d'un faux numéro.
MVOLA_RECEIVE_NUMBER=
ORANGE_MONEY_RECEIVE_NUMBER=
AIRTEL_MONEY_RECEIVE_NUMBER=

# --- Mobile money — intégration automatique désactivée pour l'instant ---
# Le paiement se fait manuellement : le client transfère lui-même l'argent
# et indique une référence, que l'admin valide dans l'onglet "Transactions".
# Les identifiants ci-dessous sont gardés pour une future intégration
# automatique (non utilisés actuellement par le code).
MVOLA_CONSUMER_KEY=
MVOLA_CONSUMER_SECRET=
MVOLA_PARTNER_MSISDN=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
